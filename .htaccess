<FilesMatch "\.(html|php|css|js|mjs|ico|xml)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Native ESM (.mjs) require JavaScript MIME type pe Apache.
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

# Secrete / diagnostic: niciodata servite public (config.json contine api_key)
<FilesMatch "^(config\.json|test-config\.php)$">
    Require all denied
</FilesMatch>
